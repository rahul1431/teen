# Monitoring Service Configuration

# Server
# NOTE: 3005 collides with the Aviator engine's port (services/game-engines/aviator/.env)
# — nginx's /ws/aviator location is hardcoded to proxy to 127.0.0.1:3005 for the
# Aviator engine, so monitoring-service must run on a different port. Production
# uses 3017.
PORT=3017
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://teen:password@localhost:5432/teen_db

# Redis
REDIS_URL=redis://localhost:6379

# WebSocket source (game-gateway)
WEBSOCKET_SOURCE_URL=ws://localhost:3004/ws
