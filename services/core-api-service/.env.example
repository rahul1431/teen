# Core API Service environment — consolidates auth, users, leaderboard, notifications, betting
# Copy to .env on the VPS: cp .env.example .env && nano .env

PORT=3001
DATABASE_URL=postgresql://teen:teen_secret_2024@localhost:5432/teen_db
REDIS_URL=redis://:teen_redis_2024@localhost:6379

# JWT (same secrets as the individual services)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP (leave OTP_PROVIDER unset or set to dev for test OTPs)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_key
MSG91_TEMPLATE_ID=your_template_id
MASTER_OTP=123456

# Wallet service (stays separate)
WALLET_SERVICE_URL=http://127.0.0.1:3003
INTERNAL_SERVICE_KEY=your_internal_key_here

# Firebase push notifications
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Referral / uploads
REFERRAL_BONUS_AMOUNT=50
APP_URL=https://game.myonlinejoker.com
AVATAR_UPLOAD_DIR=/opt/teen/uploads/avatars
KYC_UPLOAD_DIR=/opt/teen/uploads/kyc
