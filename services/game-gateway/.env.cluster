# Game Gateway Cluster Configuration
# 3 instances with stateless session management via Redis

# Instance 1
GATEWAY_1_URL=http://127.0.0.1:3004

# Instance 2
GATEWAY_2_URL=http://127.0.0.1:3005

# Instance 3
GATEWAY_3_URL=http://127.0.0.1:3006

# Shared Redis for session state
REDIS_URL=redis://:teen_redis_2024@127.0.0.1:6379

# Shared Database
DATABASE_URL=postgresql://teen:teen_secret_2024@localhost:5432/teen_db

# JWT Secret (shared across instances)
JWT_SECRET=cluster_jwt_secret_min_32_characters_long

# Wallet Service
WALLET_SERVICE_URL=http://localhost:3003

# Internal Service Key (for cluster communication)
INTERNAL_SERVICE_KEY=cluster_internal_key_2024

# Bot settings
BOT_FILL_ENABLED=true
BOT_FILL_DELAY_SECONDS=10
MAX_BOT_RATIO=0.6

# Teen Patti Engine
TEEN_PATTI_ENGINE_URL=localhost:50051

# Ludo Engine
LUDO_ENGINE_URL=http://127.0.0.1:3011

# Rummy Engine
RUMMY_ENGINE_URL=http://127.0.0.1:3012
