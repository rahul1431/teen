# Risk Service Configuration

# Server
PORT=3006
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/teen_app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Fraud Detection Configuration
FRAUD_DETECTION_ENABLED=true

# Co-location Detection: Minimum number of accounts on same device to flag
FRAUD_CO_LOCATION_THRESHOLD=3

# Win-Rate Anomaly: Threshold win rate percentage to flag
FRAUD_WIN_RATE_THRESHOLD=95

# Velocity Check: Number of hours to check transaction velocity
FRAUD_VELOCITY_HOURS=1

# Referral Chain: Depth of referral chain to check
FRAUD_REFERRAL_DEPTH=2

# Logging
LOG_LEVEL=info
